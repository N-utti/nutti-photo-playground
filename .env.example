# docs/06-architecture-deployment.md §7 환경 변수 전건

DATABASE_URL=postgres://nutti:nutti@localhost:5432/nutti
# 프로덕션(deploy/docker-compose.prod.yml): postgres 컨테이너 비밀번호 — DATABASE_URL의 비밀번호와 동일하게, 호스트는 postgres
POSTGRES_PASSWORD=nutti
# Caddy Let's Encrypt 알림 메일
ACME_EMAIL=
# openssl rand -base64 48 로 생성
JWT_SIGNING_KEY=
JWT_EXPIRES_IN=3600
# 게스트 JWT 30일 — 게스트 자산 보존과 정렬 (07-decisions#Q7)
JWT_GUEST_EXPIRES_IN=2592000
# 회원 리프레시 토큰 30일
JWT_REFRESH_EXPIRES_IN=2592000

OPENAI_API_KEY=
OPENAI_BASE_URL=
# 이미지 생성은 fal 경유 gpt-image-2 (2026-08-18 확정)
FAL_KEY=
FAL_IMAGE_ENDPOINT=openai/gpt-image-2/edit

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
CDN_BASE_URL=

CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_MALL_ID=
CAFE24_REDIRECT_URI=
# 쇼핑몰 계정 연동 OTP 발신번호 — 카페24 관리자 > SMS > 발신번호 등록값
CAFE24_SMS_SENDER_NO=

KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

ADMIN_ALERT_SLACK_WEBHOOK_URL=
SENTRY_DSN=
GA4_MEASUREMENT_ID=

BACKUP_R2_BUCKET_NAME=

# 로컬 개발에서만 development로 변경. JWT 키 가드는 development에서만 꺼짐
APP_ENV=staging
# 리버스 프록시 뒤에서만 true로 설정하고 uvicorn --proxy-headers와 병행
TRUST_PROXY=false
# Vite dev 기본 포트
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
