# docs/06-architecture-deployment.md §7 환경 변수 전건

DATABASE_URL=postgres://nutti:nutti@localhost:5432/nutti
# openssl rand -base64 48 로 생성
JWT_SIGNING_KEY=
JWT_EXPIRES_IN=3600
# 게스트 JWT 30일 — 게스트 자산 보존과 정렬 (07-decisions#Q7)
JWT_GUEST_EXPIRES_IN=2592000

OPENAI_API_KEY=
OPENAI_BASE_URL=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
CDN_BASE_URL=

CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_MALL_ID=
CAFE24_REDIRECT_URI=

KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

ADMIN_ALERT_SLACK_WEBHOOK_URL=
SENTRY_DSN=
GA4_MEASUREMENT_ID=

BACKUP_R2_BUCKET_NAME=

# 로컬 개발에서만 development로 변경. JWT 키 가드는 development에서만 꺼짐
APP_ENV=staging
# 리버스 프록시 뒤에서만 true로 설정하고 uvicorn --proxy-headers와 병행
TRUST_PROXY=false
# Vite dev 기본 포트
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
