# 개발 기본값: MSW 목 위에서 작업합니다.
#
# 더는 "전 엔드포인트가 501 이라서"가 아닙니다 — 2026-08-12 기준으로 auth · styles ·
# uploads · pets · credits · jobs(POST/GET) · 워커가 구현됐습니다. 목이 기본값인 이유는
# 이제 두 가지입니다:
#   1. library · calculator-link · events · jobs/{id}/share 가 아직 501 이라 실서버로는
#      W-09 보관함 · W-07 계산기 배너 · 공유 · 비콘을 밟을 수 없습니다(부분 전환만 가능).
#   2. 엣지 케이스(고양이 차단 · 안전 차단 · 429 · 세션 만료)를 실서버에서 재현하려면
#      DB 를 직접 만져야 하는데, 목은 시나리오 한 줄로 세웁니다(README «목 시나리오 강제»).
VITE_ENABLE_MOCKS=true

# 목을 끄고 로컬 백엔드에 붙일 때는 위를 false 로 바꾸세요.
# vite.config.ts 의 dev proxy 가 /v1 과 /media 를 localhost:8000 으로 넘깁니다
# (/media 는 로컬 스토리지 폴백이 내려주는 이미지 경로 — 없으면 이미지가 전부 404).
VITE_API_BASE_URL=/v1
