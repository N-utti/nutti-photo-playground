VITE_ENABLE_MOCKS=false

# API 호스트 — 2026-09-01 확정(deploy/README.md). 프론트와 오리진이 다르므로 서버 CORS_ALLOWED_ORIGINS에
# https://play.nutti.co.kr 가 있어야 한다(이슈 #3).
VITE_API_BASE_URL=https://api.nutti.co.kr/v1

# GA4 측정 ID — 쇼핑몰이 이미 쓰는 **그 속성**입니다.
#
# 지어낸 값이 아니라 nutti.co.kr/calculator/js/ga.js 의 `var GA_ID` 를 실측한 값이고,
# 쇼핑몰 본체(nutti.co.kr)도 카페24가 심은 Google Tag 컨테이너(GT-MBH8R5DC)를 거쳐
# 같은 속성으로 보냅니다 — 2026-08-26 에 두 페이지의 수집 비콘 `tid` 로 확인했습니다.
# 크로스도메인은 한 속성 안에서만 성립하므로 이 일치가 전제입니다.
#
# 공개값입니다(방문자 누구나 페이지 소스에서 봅니다) — 비밀이 아니라 저장소에 둡니다.
#
# ⚠️ 이 값만으로는 크로스도메인이 켜지지 않습니다. GA4 관리자 → 데이터 스트림 →
#    태그 설정 → **도메인 구성**에 놀이터 오리진을 등록해야 `_gl` 이 붙습니다.
VITE_GA4_MEASUREMENT_ID=G-KG0XE6F5XT

# 카카오 JavaScript 키 — 카카오톡 공유(app/kakaoShare.ts). 콘솔 앱 photo_create_nutti(ID 1542583)
# [플랫폼 키] › JavaScript 키. 공개값입니다(페이지에 실림) — 보호는 같은 화면의 「JavaScript SDK
# 도메인」(https://play.nutti.co.kr 등록, 2026-09-03)이 합니다. 카드 링크 도메인은 [제품 링크 관리]
# › 웹 도메인에 따로 등록해야 카카오가 카드를 받습니다(같은 날 등록).
VITE_KAKAO_JS_KEY=386e36d306d54da3845050a60d6cad2d
